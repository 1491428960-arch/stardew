    "Sophia": [
      {
        "npc": "Gus",
        "term": "家人的朋友",
        "note": "格斯从我很小的时候起就是我家人的朋友，他喜欢来看望我。去酒馆我从来不用点单，他知道我要格兰普顿香橙鸡，还总说这顿算他的。",
        "evidence": "SVE i18n zh.json: Sophia.CharacterDialogue.107 / Sophia.4hearts.HowAreYou.07 / Sophia.8hearts.14"
      },
      {
        "npc": "Lewis",
        "term": "镇长",
        "note": "刘易斯镇长和格斯一起见证了我最难的那件事。",
