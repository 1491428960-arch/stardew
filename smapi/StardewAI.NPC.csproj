<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>StardewAI.NPC</RootNamespace>
    <AssemblyName>StardewAI.NPC</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OS Condition="'$(OS)' == ''">Windows_NT</OS>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <EnableGameDebugging>false</EnableGameDebugging>
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="artifacts/**/*.cs" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- 角色气泡素材：嵌入 DLL，避免依赖 mod 目录的文件部署
         （本项目的部署脚本只复制 DLL 与 manifest.json）。 -->
    <EmbeddedResource Include="assets/npc_bubbles.png" />
    <EmbeddedResource Include="assets/npc_bubble_frames.png" />
  </ItemGroup>
</Project>
